# 红楼梦阅读分析一体化 · sidecar 环境配置模板
# 用法：复制本文件为 .env（与 honglou_sidecar.py 同目录或项目根），按需修改
# 注意：.env 已被 gitignore，密钥不提交；.env.example 是提交版本

# ── LLM 服务（OpenAI 兼容协议，DeepSeek / OpenAI / 通义 / Moonshot / 本地 Ollama 均可）──
# 示例 1：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat
#
# 示例 2：OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini
#
# 示例 3：本地 Ollama（完全离线）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
#
# 示例 4：TeleAI / 星辰大模型（OpenAI 兼容）
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=your-model-name

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# ── 嵌入模型（RAG 向量化，首次使用自动下载）
# BGE-small-zh-v1.5 = 512 维，中文语义检索，体积小
# 注意实际体积：模型文件 90.4 MB，HF 缓存在 Windows 上不建符号链接而各存一份，
# 故磁盘占用约 181 MB（blobs 与 snapshots 各一份）。
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_BATCH=16

# ── RAG 检索参数
RAG_TOP_K=6          # 召回片段数
RAG_CHUNK_LINES=20   # 每分块的行数（物理行）

# ── 数据与路径
# 运行时数据根目录（SQLite 主库 + 模型缓存）。默认 %USERPROFILE%\.honglou，
# 刻意放在同步目录之外：库含本机绝对路径、有 -wal/-shm 伴随文件，模型近 200 MB，
# 放进云盘同步目录会被客户端加锁（读写 EBUSY）并可能多机互相覆盖。
HONGLOU_DATA_DIR=
# 主库文件（不设则由 HONGLOU_DATA_DIR 推导为 <DATA_DIR>/data/honglou.sqlite）
HONGLOU_DB_PATH=
# 嵌入模型缓存目录（不设则为 <DATA_DIR>/models）
EMBED_CACHE_DIR=
# 基础资产目录（词典/人物名/emotion_analysis.py）；不设则自动上溯 ../../基础
HONGLOU_BASE_DIR=

# ── 日志
LOG_LEVEL=INFO