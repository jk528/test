' 24.2 所有方法的统一管理接口
Sub UniversalFileOpener(filePath As String, Optional method As String = "auto", Optional parameters As String = "")
    Dim wb As Workbook
    Dim openMethod As String
    
    ' 根据文件类型和参数自动选择最佳方法
    If method = "auto" Then
        openMethod = ChooseBestMethod(filePath, parameters)
    Else
        openMethod = method
    End If
    
    Debug.Print "使用打开方法: " & openMethod
    Debug.Print "文件路径: " & filePath
    Debug.Print "参数: " & parameters
    
    ' 执行打开操作
    Select Case UCase(openMethod)
        Case "WORKBOOKS.OPEN"
            Set wb = Workbooks.Open(filePath)
        Case "GETOBJECT"
            Set wb = GetObject(filePath)
        Case "CREATEOBJECT"
            Dim excelApp As Object
            Set excelApp = CreateObject("Excel.Application")
            Set wb = excelApp.Workbooks.Open(filePath)
            excelApp.Visible = True
        Case "INVISIBLE"
            Dim hiddenApp As Object
            Set hiddenApp = CreateObject("Excel.Application")
            hiddenApp.Visible = False
            Set wb = hiddenApp.Workbooks.Open(filePath)
            wb.Save
            wb.Close
            hiddenApp.Quit
        Case Else
            Set wb = Workbooks.Open(filePath)
    End Select
    
    Debug.Print "文件成功打开: " & wb.Name
End Sub

' 自动选择最佳方法
Function ChooseBestMethod(filePath As String, parameters As String) As String
    Dim fileExt As String
    Dim fileSize As Long
    
    fileExt = LCase(Right(filePath, InStrRev(filePath, ".")))
    fileSize = FileLen(filePath)
    
    ' 根据文件大小和类型选择方法
    If fileSize > 50 * 1024 * 1024 Then  ' 50MB以上
        ChooseBestMethod = "INVISIBLE"
    ElseIf fileExt = ".xlsm" Then  ' 宏文件
        ChooseBestMethod = "WORKBOOKS.OPEN"
    ElseIf fileExt = ".csv" Or fileExt = ".txt" Then
        ChooseBestMethod = "WORKBOOKS.OPEN"
    Else
        ChooseBestMethod = "WORKBOOKS.OPEN"
    End If
End Function

