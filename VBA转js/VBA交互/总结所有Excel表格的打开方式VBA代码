        Other:=False, _
        FieldInfo:=Array(Array(1, xlGeneralFormat)), _
        TrailingMinusNumbers:=True
    
    Set wb = ActiveWorkbook
    
    Application.StatusBar = False
    MsgBox "OpenText成功导入文件！尝试次数: " & attempts
    Exit Sub
    
ErrorHandler:
    If attempts < maxAttempts Then
        Application.Wait Now + TimeValue("00:00:01")  ' 等待1秒后重试
        GoTo AttemptOpen
    Else
        Application.StatusBar = False
        MsgBox "OpenText导入失败，已尝试" & attempts & "次: " & Err.Description
    End If
End Sub

' 8.8 OpenText统一管理函数
Sub UnifiedOpenTextProcessor(filePath As String, Optional settings As String = "")
    Dim wb As Workbook
    Dim fileExt As String
    
    fileExt = LCase(Right(filePath, InStrRev(filePath, ".")))
    
    Select Case fileExt
        Case ".csv"
            Call ProcessCSVFile(filePath)
        Case ".txt"
            Call ProcessTextFile(filePath)
        Case ".tsv"
            Call ProcessTSVFile(filePath)
        Case Else
            MsgBox "不支持的文件格式: " & fileExt
            Exit Sub
    End Select
    
    Set wb = ActiveWorkbook
    
    ' 通用后处理
    With wb.Worksheets(1)
        .Cells(1, 1).Select
        .Rows(1).Font.Bold = True
        .Columns.AutoFit
    End With
    
    MsgBox "文件处理完成: " & wb.Name
End Sub

