' 8.6 OpenText处理大数据文件
Sub OpenLargeTextFile()
    Dim wb As Workbook
    Dim largeFile As String
    Dim startTime As Double
    
    startTime = Timer
    largeFile = "C:\Users\代\Desktop\large_data.txt"
    
    ' 优化大数据文件导入
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False
    
    On Error GoTo ErrorHandler
    
    Workbooks.OpenText _
        fileName:=largeFile, _
        Origin:=xlWindows, _
        StartRow:=1, _
        DataType:=xlDelimited, _
        TextQualifier:=xlTextQualifierDoubleQuote, _
        ConsecutiveDelimiter:=False, _
        Tab:=False, _
        Comma:=True, _
        Semicolon:=False, _
        Space:=False, _
        Other:=False, _
        FieldInfo:=Array(Array(1, xlGeneralFormat)), _
        TrailingMinusNumbers:=True, _
        Local:=False
    
    Set wb = ActiveWorkbook
    
    ' 显示导入统计
    Dim rowCount As Long
    Dim colCount As Long
    rowCount = wb.Worksheets(1).Cells(wb.Worksheets(1).Rows.Count, 1).End(xlUp).Row
    colCount = wb.Worksheets(1).Cells(1, wb.Worksheets(1).Columns.Count).End(xlToLeft).Column
    
    Dim endTime As Double
    endTime = Timer
    
    MsgBox "大数据文件导入完成！" & vbCrLf & _
           "处理时间: " & Format(endTime - startTime, "0.0") & "秒" & vbCrLf & _
           "数据行数: " & rowCount & vbCrLf & _
           "数据列数: " & colCount
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    
    If Err.Number <> 0 Then
        MsgBox "大数据文件导入失败: " & Err.Description
    End If
End Sub

