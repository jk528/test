Sub OpenExcelWithCommonParameters()
    Dim wb As Workbook
    Set wb = Workbooks.Open( _
        Filename:="C:\Users\代\Desktop\test.xlsx", _
        UpdateLinks:=0, _              ' 0=不更新链接，1=更新链接
        ReadOnly:=False, _            ' 是否以只读模式打开
        Format:=6, _                   ' 分隔符：6=制表符，1=逗号，2=空格
        Password:="", _               ' 工作簿密码（如果有）
        WriteResPassword:="", _       ' 写入密码（如果有）
        IgnoreReadOnlyRecommended:=True, _  ' 忽略只读建议
        Origin:=xlWindows, _          ' 文件来源：xlWindows, xlMacintosh, xlMSDOS
        Delimiter:="", _              ' 分隔符（当Format=6时）
        Editable:=False, _            ' 仅适用于Excel 5.0版本
        Notify:=False, _              ' 当文件不可编辑时是否通知
        Converter:=0, _               ' 首选转换器索引
        AddToMru:=False, _            ' 是否添加到最近使用文件列表
        Local:=False, _               ' 是否使用Excel语言设置
        CorruptLoad:=xlNormalLoad      ' 损坏文件加载：xlNormalLoad, xlRepairFile, xlExtractData
    )
