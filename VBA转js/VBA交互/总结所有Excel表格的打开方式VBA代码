' 6.1 检查文件是否存在
Function FileExists(filePath As String) As Boolean
    FileExists = (Dir(filePath) <> "")
End Function

' 6.2 获取文件信息
Function GetFileInfo(filePath As String) As String
    If FileExists(filePath) Then
        GetFileInfo = "文件大小: " & FileLen(filePath) & " 字节" & vbCrLf & _
                     "创建时间: " & FileDateTime(filePath) & vbCrLf & _
                     "文件属性: " & GetAttr(filePath)
    Else
        GetFileInfo = "文件不存在"
    End If
End Function

' 6.3 安全打开文件（带错误处理）
Function SafeOpenWorkbook(filePath As String) As Workbook
    Dim wb As Workbook
    
    ' 检查文件是否存在
    If Not FileExists(filePath) Then
        MsgBox "文件不存在: " & filePath
        Set SafeOpenWorkbook = Nothing
        Exit Function
    End If
    
    On Error GoTo ErrorHandler
    
    Set wb = Workbooks.Open(filePath)
    Set SafeOpenWorkbook = wb
    Exit Function
    
ErrorHandler:
    MsgBox "打开文件时发生错误: " & Err.Description & vbCrLf & _
           "错误代码: " & Err.Number & vbCrLf & _
           "文件路径: " & filePath
    Set SafeOpenWorkbook = Nothing
End Function

' 6.4 批量打开文件夹中的所有Excel文件
Sub OpenAllExcelFilesInFolder(folderPath As String)
    Dim fileName As String
    Dim wb As Workbook
    Dim openedCount As Long
    
    If Not FileExists(folderPath) Then
        MsgBox "文件夹不存在: " & folderPath
        Exit Sub
    End If
    
    fileName = Dir(folderPath & "\*.xlsx")
    openedCount = 0
    
    Do While fileName <> ""
        Set wb = Workbooks.Open(folderPath & "\" & fileName)
        openedCount = openedCount + 1
        Debug.Print "已打开: " & fileName
        
        fileName = Dir  ' 获取下一个文件
    Loop
    
    MsgBox "共打开 " & openedCount & " 个Excel文件"
End Sub

' 6.5 智能文件选择（带预设路径）
Sub SmartFileSelection()
    Dim fd As FileDialog
    Dim selectedFile As String
    Dim wb As Workbook
    
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    
    With fd
        .Title = "智能Excel文件选择器"
        .InitialView = msoFileDialogViewDetails
        .InitialFileName = Environ("USERPROFILE") & "\Desktop\"  ' 默认到桌面
        .Filters.Clear
        .Filters.Add "Excel 2007+文件", "*.xlsx", 1
        .Filters.Add "Excel 97-2003文件", "*.xls", 2
        .Filters.Add "Excel宏文件", "*.xlsm", 3
        .Filters.Add "Excel二进制文件", "*.xlsb", 4
        .FilterIndex = 1
        
        If .Show = -1 Then
            selectedFile = .SelectedItems(1)
            
            ' 检查文件是否打开
            Dim openWb As Workbook
            For Each openWb In Workbooks
                If openWb.FullName = selectedFile Then
                    MsgBox "文件已在Excel中打开: " & openWb.Name
                    openWb.Activate
                    Set wb = openWb
                    GoTo ProcessFile
                End If
            Next openWb
            
            ' 打开新文件
            Set wb = Workbooks.Open(selectedFile)
            
ProcessFile:
            MsgBox "已处理文件: " & wb.Name & vbCrLf & _
                   "工作表数量: " & wb.Worksheets.Count
            
        Else
            MsgBox "用户取消了文件选择"
        End If
    End With
    
    Set fd = Nothing
End Sub

