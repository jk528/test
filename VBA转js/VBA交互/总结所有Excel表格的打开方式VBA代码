' 测试单个函数
Sub TestFunction(funcName As String, ByRef testResults As String, ByRef totalTests As Long, ByRef passedTests As Long, ByRef failedTests As Long, ByRef detailedResults As String)
    Dim result As Boolean
    Dim errorMsg As String
    Dim testStart As Double
    Dim testDuration As Double
    
    testStart = Timer
    errorMsg = ""
    
    On Error GoTo TestError
    
    ' 动态调用函数
    Select Case funcName
        Case "CheckBasicFunctionsV35"
            result = CheckBasicFunctionsV35()
        Case "CheckObjectReferencesV35"
            result = CheckObjectReferencesV35()
        Case "CheckFilePermissions"
            result = CheckFilePermissions()
        Case "CheckBasicObjectCreation"
            result = CheckBasicObjectCreation()
        Case "CheckBasicVBAFunctions"
            result = CheckBasicVBAFunctions()
        Case "CheckExcelSpecificFunctions"
            result = CheckExcelSpecificFunctions()
        Case "RunSimpleTestFunction"
            result = RunSimpleTestFunction()
        Case Else
            result = False
            errorMsg = "未知测试函数"
    End Select
    
    testDuration = Timer - testStart
    
    ' 更新统计
    totalTests = totalTests + 1
    
    If result Then
        passedTests = passedTests + 1
        Debug.Print "   ✅ " & funcName & " - 通过 (" & Format(testDuration / 1000, "0.000") & "s)"
        testResults = testResults & funcName & ": PASS ✓" & vbCrLf
    Else
        failedTests = failedTests + 1
        Debug.Print "   ❌ " & funcName & " - 失败 (" & Format(testDuration / 1000, "0.000") & "s)"
        If errorMsg = "" Then errorMsg = "函数返回False"
        testResults = testResults & funcName & ": FAIL ✗ (" & errorMsg & ")" & vbCrLf
        detailedResults = detailedResults & "• " & funcName & ": " & errorMsg & vbCrLf
    End If
    
    Exit Sub
    
TestError:
    testDuration = Timer - testStart
    failedTests = failedTests + 1
    totalTests = totalTests + 1
    errorMsg = Err.Description
    Debug.Print "   ❌ " & funcName & " - 错误 (" & Format(testDuration / 1000, "0.000") & "s): " & errorMsg
    testResults = testResults & funcName & ": ERROR ✗ (" & errorMsg & ")" & vbCrLf
    detailedResults = detailedResults & "• " & funcName & ": " & errorMsg & vbCrLf
End Sub

' 生成测试报告文件
Sub GenerateTestReport(totalTests As Long, passedTests As Long, failedTests As Long, testResults As String, detailedResults As String, duration As Double)
    Dim reportPath As String
    Dim reportContent As String
    Dim fileNum As Integer
    Dim currentTime As String
    
    currentTime = Format(Now(), "yyyy-mm-dd hh-mm-ss")
    reportPath = ThisWorkbook.Path & "\VBA_Test_Report_" & currentTime & ".txt"
    
    reportContent = "VBA统合测试报告" & vbCrLf
    reportContent = reportContent & "==================" & vbCrLf & vbCrLf
    reportContent = reportContent & "生成时间: " & Now() & vbCrLf
    reportContent = reportContent & "文件路径: " & ThisWorkbook.FullName & vbCrLf & vbCrLf
    
    reportContent = reportContent & "测试摘要:" & vbCrLf
    reportContent = reportContent & "总测试数: " & totalTests & vbCrLf
    reportContent = reportContent & "通过数: " & passedTests & " (" & FormatPercent(passedTests / totalTests, 1) & ")" & vbCrLf
    reportContent = reportContent & "失败数: " & failedTests & " (" & FormatPercent(failedTests / totalTests, 1) & ")" & vbCrLf
    reportContent = reportContent & "执行时间: " & Format(duration / 1000, "0.00") & " 秒" & vbCrLf & vbCrLf
    
    reportContent = reportContent & "详细结果:" & vbCrLf
    reportContent = reportContent & testResults & vbCrLf
    
    If failedTests > 0 Then
        reportContent = reportContent & "失败详情:" & vbCrLf
        reportContent = reportContent & detailedResults & vbCrLf
    End If
    
    reportContent = reportContent & "状态: " & IIf(failedTests = 0, "✅ 所有测试通过", "❌ 有测试失败") & vbCrLf
    
    ' 写入文件
    fileNum = FreeFile
    Open reportPath For Output As #fileNum
    Print #fileNum, reportContent
    Close #fileNum
    
    Debug.Print "测试报告已保存至: " & reportPath
End Sub

