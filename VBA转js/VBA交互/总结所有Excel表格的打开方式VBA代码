' 8.1 基础OpenText使用
Sub BasicOpenTextExample()
    Dim wb As Workbook
    Dim textFilePath As String
    
    textFilePath = "C:\Users\代\Desktop\data.txt"
    
    ' 使用OpenText方法打开文本文件，自动分列
    Workbooks.OpenText _
        Filename:=textFilePath, _
        Origin:=xlWindows, _                    ' 文件来源：xlWindows, xlMacintosh, xlMSDOS
        StartRow:=1, _                          ' 开始读取行号
        DataType:=xlDelimited, _                ' 数据类型：xlDelimited, xlFixedWidth
        TextQualifier:=xlTextQualifierDoubleQuote, _  ' 文本限定符
        ConsecutiveDelimiter:=False, _          ' 是否将连续分隔符作为一个
        Tab:=False, _                           ' 使用制表符作为分隔符
        Semicolon:=False, _                     ' 使用分号作为分隔符
        Comma:=True, _                          ' 使用逗号作为分隔符
        Space:=False, _                         ' 使用空格作为分隔符
        Other:=False, _                         ' 使用其他字符作为分隔符
        OtherChar:="", _                        ' 其他分隔符字符
        FieldInfo:=Array(Array(1, xlGeneralFormat), Array(2, xlTextFormat)), _  ' 字段信息
        TrailingMinusNumbers:=True, _           ' 处理尾随负号
        Local:=False                            ' 是否使用本地设置
    
    Set wb = ActiveWorkbook
    
    ' 保存为Excel格式
    wb.SaveAs Replace(textFilePath, ".txt", ".xlsx"), xlOpenXMLWorkbook
    
    MsgBox "使用OpenText成功导入文本文件"
End Sub

