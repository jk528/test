' 21.1 增强的错误处理机制
Sub AdvancedErrorHandling()
    Dim wb As Workbook
    Dim filePath As String
    Dim retryCount As Integer
    Dim maxRetries As Integer
    
    filePath = "C:\Users\代\Desktop\problematic.xlsx"
    maxRetries = 3
    retryCount = 0
    
RetryOpen:
    retryCount = retryCount + 1
    
    On Error GoTo ErrorHandler
    
    Set wb = Workbooks.Open(filePath, readOnly:=True)
    
    MsgBox "文件成功打开"
    Exit Sub
    
ErrorHandler:
    Debug.Print "尝试 " & retryCount & "/" & maxRetries & " 失败: " & Err.Description
    
    If retryCount < maxRetries Then
        ' 等待一秒后重试
        Application.Wait Now + TimeValue("00:00:01")
        GoTo RetryOpen
    Else
        ' 最后尝试：使用修复模式打开
        On Error Resume Next
        Set wb = Workbooks.Open(filePath, CorruptLoad:=xlRepairFile)
        If Err.Number = 0 Then
            MsgBox "使用修复模式成功打开文件"
            wb.Close False
        Else
            MsgBox "所有打开方式均失败，请手动检查文件"
        End If
        On Error GoTo 0
    End If
End Sub

