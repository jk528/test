' 检查文件是否被锁定
Function IsFileLocked(filePath As String) As Boolean
    Dim fileNum As Integer
    
    On Error GoTo ErrorHandler
    
    fileNum = FreeFile
    Open filePath For Binary Access Read Lock Read As #fileNum
    Close #fileNum
    IsFileLocked = False
    Exit Function
    
ErrorHandler:
    IsFileLocked = True
    If fileNum > 0 Then Close #fileNum
End Function

