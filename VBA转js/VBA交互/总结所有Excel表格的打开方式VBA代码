' 3.1 基本文件选择
Sub OpenExcelWithDialog()
    Dim fd As FileDialog
    Dim selectedFile As String
    Dim wb As Workbook
    
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    
    With fd
        .Title = "请选择要打开的Excel文件"
        .Filters.Clear
        .Filters.Add "Excel文件", "*.xlsx;*.xls;*.xlsm;*.xlsb", 1
        .FilterIndex = 1
        .AllowMultiSelect = False
        
        If .Show = -1 Then
            selectedFile = .SelectedItems(1)
            Set wb = Workbooks.Open(selectedFile)
            MsgBox "成功打开文件: " & selectedFile
        Else
            MsgBox "用户取消了文件选择"
        End If
    End With
    
    Set fd = Nothing
End Sub

' 3.2 多文件选择（批量打开）
Sub OpenMultipleExcelFiles()
    Dim fd As FileDialog
    Dim fileItem As Variant
    Dim wb As Workbook
    Dim openedCount As Long
    
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    
    With fd
        .Title = "请选择要打开的多个Excel文件"
        .Filters.Clear
        .Filters.Add "Excel文件", "*.xlsx;*.xls;*.xlsm;*.xlsb", 1
        .AllowMultiSelect = True
        
        If .Show = -1 Then
            openedCount = 0
            For Each fileItem In .SelectedItems
                Set wb = Workbooks.Open(fileItem)
                openedCount = openedCount + 1
            Next fileItem
            MsgBox "成功打开 " & openedCount & " 个文件"
        Else
            MsgBox "用户取消了文件选择"
        End If
    End With
    
    Set fd = Nothing
End Sub

