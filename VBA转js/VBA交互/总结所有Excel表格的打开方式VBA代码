' 25.1 优化的安全打开函数
Function SafeOpenWorkbookOptimized(filePath As String, Optional readOnly As Boolean = False, Optional updateLinks As Integer = 0) As Workbook
    Dim wb As Workbook
    Dim attempts As Integer
    Dim maxAttempts As Integer
    
    maxAttempts = 3
    attempts = 0
    
RetryOpen:
    attempts = attempts + 1
    
    On Error GoTo ErrorHandler
    
    ' 优化设置
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    
    Set wb = Workbooks.Open( _
        fileName:=filePath, _
        readOnly:=readOnly, _
        updateLinks:=updateLinks, _
        IgnoreReadOnlyRecommended:=True, _
        CorruptLoad:=xlNormalLoad _
    )
    
    ' 恢复设置
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    Set SafeOpenWorkbookOptimized = wb
    Exit Function
    
ErrorHandler:
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    If attempts < maxAttempts Then
        ' TimeValue 不支持毫秒格式；改用 TimeSerial 按秒递增等待（1秒、2秒、3秒...）
        Application.Wait Now + TimeSerial(0, 0, attempts)
        GoTo RetryOpen
    Else
        ' 尝试修复模式
        On Error Resume Next
        Set wb = Workbooks.Open( _
            fileName:=filePath, _
            readOnly:=readOnly, _
            updateLinks:=updateLinks, _
            CorruptLoad:=xlRepairFile _
        )
        
        If Err.Number = 0 Then
            Set SafeOpenWorkbookOptimized = wb
        Else
            Debug.Print "文件打开完全失败: " & filePath & " - " & Err.Description
            Set SafeOpenWorkbookOptimized = Nothing
        End If
        
        On Error GoTo 0
    End If
End Function

' 25.2 优化的文件信息获取（修复Dictionary类型错误）
Function GetOptimizedFileInfo(filePath As String) As Object
    Dim dict As Object
    Dim fso As Object
    Dim fileObj As Object
    
    Set dict = CreateObject("Scripting.Dictionary")
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    If fso.FileExists(filePath) Then
        Set fileObj = fso.GetFile(filePath)
        
        dict("Name") = fileObj.Name
        dict("Size") = fileObj.Size
        dict("DateCreated") = fileObj.DateCreated
        dict("DateLastModified") = fileObj.DateLastModified
        dict("Extension") = fso.GetExtensionName(filePath)
        dict("ParentFolder") = fileObj.ParentFolder
        
        ' Excel特定信息
        Dim ext As String
        ext = LCase(dict("Extension"))
        
        If ext = "xlsx" Or ext = "xls" Or ext = "xlsm" Or ext = "xlsb" Then
            dict("IsExcel") = True
            dict("Format") = "Excel Format"
        ElseIf ext = "csv" Or ext = "txt" Then
            dict("IsExcel") = False
            dict("Format") = "Text Format"
        Else
            dict("IsExcel") = False
            dict("Format") = "Other Format"
        End If
        
        Set fileObj = Nothing
    Else
        dict("Exists") = False
    End If
    
    Set fso = Nothing
    Set GetOptimizedFileInfo = dict
End Function

' 25.3 智能文件路径处理
Function SmartPathResolver(fileName As String, Optional basePath As String = "") As String
    Dim resolvedPath As String
    
    If basePath = "" Then basePath = "C:\Users\代\Desktop\"
    
    ' 如果是绝对路径，直接返回
    If InStr(fileName, ":") > 0 Then
        SmartPathResolver = fileName
        Exit Function
    End If
    
    ' 处理相对路径
    If Left(fileName, 1) = "\" Then
        resolvedPath = basePath & Mid(fileName, 2)
    Else
        resolvedPath = basePath & fileName
    End If
    
    SmartPathResolver = resolvedPath
End Function

